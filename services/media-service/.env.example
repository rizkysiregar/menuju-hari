# === Menuju Hari — media-service ===
# Salin menjadi `.env` lalu isi. TIDAK pernah di-commit.

# Database di infra VM — beda service hanya beda DB_NAME (media_db).
DB_HOST=192.168.1.50
DB_PORT=5433
DB_NAME=media_db
DB_USER=infra_dev_admin
DB_PASSWORD=isi_password_infra_dev_admin

# Redis infra VM (dipakai bersama).
REDIS_HOST=192.168.1.50
REDIS_PORT=6379

# --- MinIO (infra VM; console di :9001) ---
MINIO_ENDPOINT=http://192.168.1.50:9000
MINIO_BUCKET=menujuhari
MINIO_ACCESS_KEY=isi_access_key_minio
MINIO_SECRET_KEY=isi_secret_key_minio

# Base URL catalog-service (lookup object key musik).
CATALOG_BASE_URL=http://localhost:8083

# Origin frontend yang diizinkan (dipisah koma).
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
