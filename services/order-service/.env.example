# === Menuju Hari — order-service ===
# Salin menjadi `.env` lalu isi. TIDAK pernah di-commit.

# Database di infra VM — beda service hanya beda DB_NAME (order_db).
DB_HOST=192.168.1.50
DB_PORT=5433
DB_NAME=order_db
DB_USER=infra_dev_admin
DB_PASSWORD=isi_password_infra_dev_admin

# Redis infra VM (dipakai bersama, termasuk event stream).
REDIS_HOST=192.168.1.50
REDIS_PORT=6379

# Base URL service lain (default localhost saat dev).
CATALOG_BASE_URL=http://localhost:8083
PAYMENT_BASE_URL=http://localhost:8086

# Origin frontend yang diizinkan (dipisah koma).
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
