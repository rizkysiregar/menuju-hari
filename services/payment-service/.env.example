# === Menuju Hari — payment-service ===
# Salin menjadi `.env` lalu isi. TIDAK pernah di-commit.
#
# Cara mendapatkan kredensial Midtrans:
#   Sandbox  : buka dashboard.sandbox.midtrans.com -> Settings -> Access Keys
#   Produksi : buka dashboard.midtrans.com (setelah akun terverifikasi)
#              -> Settings -> Access Keys
# Sandbox: ServerKey berawalan SB-Mid-server-..., ClientKey SB-Mid-client-...
# JANGAN pernah commit Server Key atau membagikannya.

# Database di infra VM — beda service hanya beda DB_NAME (payment_db).
DB_HOST=192.168.1.50
DB_PORT=5433
DB_NAME=payment_db
DB_USER=infra_dev_admin
DB_PASSWORD=isi_password_infra_dev_admin

# Redis infra VM (event stream payment.settled).
REDIS_HOST=192.168.1.50
REDIS_PORT=6379

# --- Midtrans ---
MIDTRANS_IS_SANDBOX=true
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxx
MIDTRANS_MERCHANT_ID=xxxxxxx

# Origin frontend yang diizinkan (dipisah koma).
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
