# === Menuju Hari — identity-service ===
# Salin file ini menjadi `.env` (di directory yang sama) lalu isi nilainya.
# .env TIDAK pernah di-commit (sudah masuk .gitignore).

# --- Database (PostgreSQL di infra VM; yang berbeda antar service hanya DB_NAME) ---
DB_HOST=192.168.1.50
DB_PORT=5433
DB_NAME=identity_db
DB_USER=infra_dev_admin
DB_PASSWORD=isi_password_infra_dev_admin

# --- Redis (infra VM, dipakai bersama semua service) ---
REDIS_HOST=192.168.1.50
REDIS_PORT=6379

# --- Gmail SMTP untuk OTP ---
# Gunakan App Password Gmail (bukan password akun):
# 1. Aktifkan verifikasi 2 langkah pada akun Google Anda.
# 2. Buka myaccount.google.com -> Security -> App passwords.
# 3. Buat App Password (mail), lalu isi 16 karakter DI BAWAH TANPA SPASI.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alamat@gmail.com
MAIL_PASSWORD=app_password_16_karakter
MAIL_FROM=Menuju Hari <alamat@gmail.com>

# true = OTP dicetak ke log alih-alih dikirim (HANYA untuk dev lokal).
# WAJIB false saat berjalan di staging/produksi.
MAIL_CONSOLE_FALLBACK=false

# Origin frontend yang diizinkan (dipisah koma).
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
